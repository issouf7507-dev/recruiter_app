generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  type          UserType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  candidat      Candidat?      @relation("UserAsCandidat")
  collaborateur Collaborateur?
  recruteur     Recruteur?     @relation("UserAsRecruteur")
  sessions      Session[]
}

model Candidat {
  id                  String               @id @default(cuid())
  userId              String               @unique
  nom                 String?
  prenom              String?
  telephone           String?
  cv                  String?
  letterm             String?
  email               String               @unique
  bio                 String?
  adresse             String?
  ville               String?
  statut              String?
  pays                String
  dateNaissance       DateTime
  nationalite         String?
  situationFamiliale  String?
  permisConduire      String?
  image               String?
  alertes             AlerteEmploi[]
  applications        Application[]
  user                User                 @relation("UserAsCandidat", fields: [userId], references: [id], onDelete: Cascade)
  candidatCompetences CandidatCompetence[]
  competencesList     Competence[]
  conversations       Conversation[]
  experiences         Experience[]
  formations          Formation[]
  notifications       Notification[]
  objectifs           ObjectifCarriere[]
}

model CandidatCompetence {
  id         String   @id @default(cuid())
  candidatId String
  competence String
  createdAt  DateTime @default(now())
  candidat   Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)

  @@unique([candidatId, competence])
}

model Recruteur {
  id                  String                @id @default(cuid())
  userId              String                @unique
  type                RecruteurType
  entreprise          String?
  description         String?
  name                String
  logo                String?
  industry            String?
  size                String?
  location            String?
  website             String?
  email               String                @unique
  phone               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  collaborateurs      Collaborateur[]
  social              CompanySocial?
  conversations       Conversation[]
  invitations         Invitation[]
  JobOffer            JobOffer[]
  OfferTemplate       OfferTemplate[]
  CollaborateurCustom CollaborateurCustom[]
  // ApplicationCustom ApplicationCustom[]
  KanbanColumnCustom  KanbanColumnCustom[]
  user                User                  @relation("UserAsRecruteur", fields: [userId], references: [id], onDelete: Cascade)
}

model CompanySocial {
  id          String    @id @default(cuid())
  linkedin    String?
  twitter     String?
  recruteurId String    @unique
  recruteur   Recruteur @relation(fields: [recruteurId], references: [id], onDelete: Cascade)
}

model Invitation {
  id            String         @id @default(cuid())
  email         String
  recruteurId   String
  role          Role
  token         String         @unique
  accepted      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  collaborateur Collaborateur?
  recruteur     Recruteur      @relation(fields: [recruteurId], references: [id], onDelete: Cascade)

  @@index([recruteurId], map: "Invitation_recruteurId_fkey")
}

model Collaborateur {
  id           String    @id @default(cuid())
  email        String    @unique
  nom          String
  prenom       String
  role         Role
  recruteurId  String
  invitationId String?   @unique
  userId       String    @unique
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications ApplicationCollaborateur[]
  invitation   Invitation?                @relation(fields: [invitationId], references: [id])
  recruteur    Recruteur                  @relation(fields: [recruteurId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recruteurId], map: "Collaborateur_recruteurId_fkey")
}

model ApplicationCollaborateur {
  id              String        @id @default(cuid())
  applicationId   String
  collaborateurId String
  assignedAt      DateTime      @default(now())
  assignedBy      String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  collaborateur   Collaborateur @relation(fields: [collaborateurId], references: [id], onDelete: Cascade)

  @@unique([applicationId, collaborateurId])
  @@index([collaborateurId], map: "ApplicationCollaborateur_collaborateurId_fkey")
}

/// Représente une offre d'emploi publiée par une entreprise
model JobOffer {
  id                  Int                  @id @default(autoincrement())
  title               String
  description         String?              @db.Text
  company             String?
  location            String?
  type                String?
  etat                String?              @default("active")
  experience          String?
  salaryMin           Float?
  salaryMax           Float?
  salaryCurrency      String?
  salaryPeriod        String?
  benefits            String?              @db.Text
  requirements        String?              @db.Text
  responsibilities    String?              @db.Text
  duedate             DateTime?
  skills              String?
  favorite            Boolean?             @default(false)
  templateId          Int?
  views               Int?                 @default(0)
  recruteurId         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  applications        Application[]
  conversations       Conversation[]
  recruteur           Recruteur            @relation(fields: [recruteurId], references: [id], onDelete: Cascade)
  template            OfferTemplate?       @relation(fields: [templateId], references: [id])
  jobOfferCompetences JobOfferCompetence[]
  kanbanColumns       KanbanColumn[]

  @@index([recruteurId], map: "JobOffer_recruteurId_fkey")
  @@index([templateId], map: "JobOffer_templateId_fkey")
}

model JobOfferCompetence {
  id         String   @id @default(cuid())
  jobOfferId Int
  competence String
  createdAt  DateTime @default(now())
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([jobOfferId, competence])
}

/// Représente un modèle d'offre d'emploi pouvant être réutilisé
model OfferTemplate {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  content     String
  recruteurId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  offers      JobOffer[]
  recruteur   Recruteur  @relation(fields: [recruteurId], references: [id], onDelete: Cascade)

  @@index([recruteurId], map: "OfferTemplate_recruteurId_fkey")
}

model Application {
  id             String                     @id @default(cuid())
  candidatId     String
  jobOfferId     Int
  columnId       String
  rating         Int?
  message        String?
  cv             String?
  favorite       Boolean?                   @default(false)
  duedate        DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  candidat       Candidat                   @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  column         KanbanColumn               @relation(fields: [columnId], references: [id], onDelete: Cascade)
  jobOffer       JobOffer                   @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  collaborateurs ApplicationCollaborateur[]
  files          ApplicationFile[]
  notes          ApplicationNote[]
  checklist      ChecklistItem[]

  @@index([candidatId], map: "Application_candidatId_fkey")
  @@index([columnId], map: "Application_columnId_fkey")
  @@index([jobOfferId], map: "Application_jobOfferId_fkey")
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  content       String
  authorId      String
  authorName    String?
  authorType    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "ApplicationNote_applicationId_fkey")
}

model ChecklistItem {
  id            String      @id @default(cuid())
  applicationId String
  title         String
  description   String?
  isCompleted   Boolean     @default(false)
  createdById   String
  createdByType String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "ChecklistItem_applicationId_fkey")
}

model ApplicationFile {
  id             String      @id @default(cuid())
  applicationId  String
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  uploadedById   String
  uploadedByType String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "ApplicationFile_applicationId_fkey")
}

model KanbanColumn {
  id           String        @id @default(cuid())
  color        String
  name         String
  order        Int
  isDefault    Boolean       @default(false)
  jobOfferId   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  jobOffer     JobOffer      @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@index([jobOfferId], map: "KanbanColumn_jobOfferId_fkey")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Experience {
  id                    String                 @id @default(cuid())
  poste                 String
  entreprise            String
  localisation          String
  typeContrat           String
  dateDebut             DateTime
  dateFin               DateTime?
  description           String
  candidatId            String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  candidat              Candidat               @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  experienceCompetences ExperienceCompetence[]

  @@index([candidatId], map: "Experience_candidatId_fkey")
}

model ExperienceCompetence {
  id           String     @id @default(cuid())
  experienceId String
  competence   String
  createdAt    DateTime   @default(now())
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, competence])
}

model Formation {
  id              String           @id @default(cuid())
  diplome         String
  etablissement   String
  domaine         String
  dateDebut       DateTime
  dateFin         DateTime?
  description     String
  candidatId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  candidat        Candidat         @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  formationEtapes FormationEtape[]

  @@index([candidatId], map: "Formation_candidatId_fkey")
}

model FormationEtape {
  id          String    @id @default(cuid())
  formationId String
  etape       String
  createdAt   DateTime  @default(now())
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([formationId, etape])
}

model Competence {
  id         String   @id @default(cuid())
  categorie  String
  nom        String
  niveau     Int
  candidatId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  candidat   Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)

  @@index([candidatId], map: "Competence_candidatId_fkey")
}

model ObjectifCarriere {
  id             String          @id @default(cuid())
  titre          String
  description    String
  categorie      String
  dateLimite     DateTime
  progression    Int             @default(0)
  candidatId     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  candidat       Candidat        @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  objectifEtapes ObjectifEtape[]

  @@index([candidatId], map: "ObjectifCarriere_candidatId_fkey")
}

model ObjectifEtape {
  id         String           @id @default(cuid())
  objectifId String
  etape      String
  createdAt  DateTime         @default(now())
  objectif   ObjectifCarriere @relation(fields: [objectifId], references: [id], onDelete: Cascade)

  @@unique([objectifId, etape])
}

model AlerteEmploi {
  id                String         @id @default(cuid())
  titre             String
  localisation      String
  typeContrat       String
  salaireMin        Float?
  salaireMax        Float?
  experience        String
  frequence         String
  active            Boolean        @default(true)
  derniereMiseAJour DateTime       @default(now())
  nombreResultats   Int            @default(0)
  candidatId        String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  candidat          Candidat       @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  alerteMotsCles    AlerteMotCle[]

  @@index([candidatId], map: "AlerteEmploi_candidatId_fkey")
}

model AlerteMotCle {
  id        String       @id @default(cuid())
  alerteId  String
  motCle    String
  createdAt DateTime     @default(now())
  alerte    AlerteEmploi @relation(fields: [alerteId], references: [id], onDelete: Cascade)

  @@unique([alerteId, motCle])
}

model Notification {
  id         String   @id @default(cuid())
  titre      String
  message    String
  type       String
  lu         Boolean  @default(false)
  candidatId String
  offreId    Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  candidat   Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)

  @@index([candidatId], map: "Notification_candidatId_fkey")
}

model Conversation {
  id          String    @id @default(cuid())
  jobOfferId  Int
  candidatId  String
  recruteurId String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidat    Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  jobOffer    JobOffer  @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  recruteur   Recruteur @relation(fields: [recruteurId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([jobOfferId, candidatId, recruteurId])
  @@index([candidatId], map: "Conversation_candidatId_fkey")
  @@index([recruteurId], map: "Conversation_recruteurId_fkey")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  senderType     SenderType
  content        String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "Message_conversationId_fkey")
}

enum UserType {
  CANDIDAT
  RECRUTEUR
  COLLABORATEUR
}

enum RecruteurType {
  PARTICULIER
  ENTREPRISE
  ENTITE
}

enum Role {
  ADMIN
  USER
  MANAGER
  VIEWER
}

enum SenderType {
  CANDIDAT
  RECRUTEUR
}

//custum kanban
model KanbanColumnCustom {
  id                   String   @id @default(cuid())
  color                String
  name                 String
  order                Int
  isDefault            Boolean  @default(false)
  jobOfferId           Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  recruteurId          String
  applicationsCustomid String

  applicationsCustom ApplicationCustom[]
  recruteur          Recruteur           @relation(fields: [recruteurId], references: [id], onDelete: Cascade)

  @@index([recruteurId], map: "KanbanColumnCustom_recruteurId_fkey")
}

model CollaborateurCustom {
  id           String                           @id @default(cuid())
  email        String                           @unique
  nom          String
  prenom       String
  role         Role
  recruteurId  String
  invitationId String?                          @unique
  userId       String                           @unique
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  applications ApplicationCollaborateurCustom[]
  // invitation   Invitation?                @relation(fields: [invitationId], references: [id])
  recruteur    Recruteur                        @relation(fields: [recruteurId], references: [id], onDelete: Cascade)
  // user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recruteurId], map: "CollaborateurCustom_recruteurId_fkey")
}

model ApplicationFileCustom {
  id             String            @id @default(cuid())
  applicationId  String
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  uploadedById   String
  uploadedByType String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  application    ApplicationCustom @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "ApplicationFileCustom_applicationId_fkey")
}

model ApplicationCollaborateurCustom {
  id              String              @id @default(cuid())
  applicationId   String
  collaborateurId String
  assignedAt      DateTime            @default(now())
  assignedBy      String
  application     ApplicationCustom   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  collaborateur   CollaborateurCustom @relation(fields: [collaborateurId], references: [id], onDelete: Cascade)

  @@unique([applicationId, collaborateurId])
  @@index([collaborateurId], map: "ApplicationCollaborateurCustom_collaborateurId_fkey")
}

model ApplicationNoteCustom {
  id            String            @id @default(cuid())
  applicationId String
  content       String
  authorId      String
  authorName    String?
  authorType    String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  application   ApplicationCustom @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "ApplicationNoteCustom_applicationId_fkey")
}

model ChecklistItemCustom {
  id            String            @id @default(cuid())
  applicationId String
  title         String
  description   String?
  isCompleted   Boolean           @default(false)
  createdById   String
  createdByType String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  application   ApplicationCustom @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "ChecklistItem_applicationId_fkey")
}

model CandidatCustom {
  id                 String   @id @default(cuid())
  nom                String?
  prenom             String?
  role               Role?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             String   @unique
  telephone          String?
  cv                 String?
  letterm            String?
  bio                String?
  adresse            String?
  ville              String?
  statut             String?
  pays               String?
  dateNaissance      DateTime
  nationalite        String?
  situationFamiliale String?
  permisConduire     String?
  image              String?

  applicationId String
  application   ApplicationCustom @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "CandidatCustom_applicationId_fkey")
}

model ApplicationCustom {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  company     String
  location    String
  duedate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  collaborateurs ApplicationCollaborateurCustom[]
  files          ApplicationFileCustom[]
  notes          ApplicationNoteCustom[]
  checklist      ChecklistItemCustom[]
  candidatCustom CandidatCustom[]

  kanbanColumnCustomid String
  recruteur            KanbanColumnCustom @relation(fields: [kanbanColumnCustomid], references: [id], onDelete: Cascade)
}
