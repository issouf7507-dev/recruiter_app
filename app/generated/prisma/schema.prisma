// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String? // facultatif si tu fais du social login
  image         String?
  type          UserType
  candidat      Candidat?      @relation("UserAsCandidat")
  recruteur     Recruteur?     @relation("UserAsRecruteur")
  collaborateur Collaborateur?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Candidat {
  id                 String             @id @default(cuid())
  user               User               @relation("UserAsCandidat", fields: [userId], references: [id])
  userId             String             @unique
  nom                String?
  prenom             String?
  telephone          String?
  cv                 String?
  letterm            String?
  email              String             @unique
  bio                String?
  adresse            String?
  ville              String?
  statut             String?
  pays               String
  dateNaissance      DateTime
  nationalite        String?
  situationFamiliale String?
  permisConduire     String?
  competences        String[]           @default([])
  image              String?
  favorite           Boolean?           @default(false)
  applications       Application[]
  experiences        Experience[]
  formations         Formation[]
  competencesList    Competence[]
  objectifs          ObjectifCarriere[]
  alertes            AlerteEmploi[]
  notifications      Notification[]
}

model Recruteur {
  id             String          @id @default(cuid())
  user           User            @relation("UserAsRecruteur", fields: [userId], references: [id])
  userId         String          @unique
  type           RecruteurType
  entreprise     String?
  description    String?
  name           String
  logo           String?
  industry       String?
  size           String? // Ex : "50-200 employés"
  location       String?
  website        String?
  email          String          @unique
  phone          String?
  social         CompanySocial?
  OfferTemplate  OfferTemplate[]
  JobOffer       JobOffer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invitations    Invitation[]
  collaborateurs Collaborateur[]
}

model CompanySocial {
  id          String    @id @default(cuid())
  linkedin    String?
  twitter     String?
  recruteur   Recruteur @relation(fields: [recruteurId], references: [id])
  recruteurId String    @unique
}

model Invitation {
  id            String         @id @default(cuid())
  email         String // Email invité
  recruteurId   String
  recruteur     Recruteur      @relation(fields: [recruteurId], references: [id])
  role          Role
  token         String         @unique // Pour sécuriser l'invitation
  accepted      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime // Date d'expiration de l'invitation
  collaborateur Collaborateur? // Relation avec le collaborateur une fois acceptée
}

model Collaborateur {
  id           String                     @id @default(cuid())
  email        String                     @unique
  nom          String
  prenom       String
  role         Role
  recruteurId  String
  recruteur    Recruteur                  @relation(fields: [recruteurId], references: [id])
  invitation   Invitation?                @relation(fields: [invitationId], references: [id])
  invitationId String?                    @unique
  user         User                       @relation(fields: [userId], references: [id])
  userId       String                     @unique
  applications ApplicationCollaborateur[] // Relation many-to-many avec les applications
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

// Table de liaison pour la relation many-to-many entre Application et Collaborateur
model ApplicationCollaborateur {
  id              String        @id @default(cuid())
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  collaborateur   Collaborateur @relation(fields: [collaborateurId], references: [id], onDelete: Cascade)
  collaborateurId String
  assignedAt      DateTime      @default(now())
  assignedBy      String // ID de l'utilisateur qui a fait l'affectation

  @@unique([applicationId, collaborateurId])
}

/// Représente une offre d'emploi publiée par une entreprise
model JobOffer {
  id               Int            @id @default(autoincrement()) // Identifiant unique de l'offre
  title            String // Titre du poste (ex : Développeur Full Stack)
  description      String // Description générale du poste
  company          String // Nom de l'entreprise proposant l'offre
  location         String // Lieu de travail (ex : Abidjan, télétravail)
  type             String // Type de contrat (ex : Freelance, CDI, CDD)
  etat             String         @default("active")
  experience       String // Années d'expérience requises (ex : "2-5")
  salaryMin        Float // Salaire minimum proposé
  salaryMax        Float // Salaire maximum proposé
  salaryCurrency   String // Devise du salaire (ex : XOF, EUR, USD)
  salaryPeriod     String // Périodicité du salaire (ex : mois, an)
  benefits         String // Avantages (ex : mutuelle, tickets resto)
  requirements     String // Exigences spécifiques du poste
  responsibilities String // Responsabilités principales du poste
  skills           String // Compétences nécessaires (ex : JavaScript, React)
  favorite         Boolean?       @default(false)
  templateId       Int? // ID du modèle d'offre utilisé (optionnel)
  competences      String[]       @default([])
  views            Int            @default(0) // Nouveau champ pour le compteur de vues
  template         OfferTemplate? @relation(fields: [templateId], references: [id]) // Relation vers le modèle d'offre utilisé
  recruteur        Recruteur      @relation(fields: [recruteurId], references: [id])
  recruteurId      String
  createdAt        DateTime       @default(now()) // Date de création de l'offre
  updatedAt        DateTime       @updatedAt // Date de dernière mise à jour de l'offre
  kanbanColumns    KanbanColumn[] // Liste des colonnes associées à cette offre
  applications     Application[]
}

/// Représente un modèle d'offre d'emploi pouvant être réutilisé
model OfferTemplate {
  id          Int        @id @default(autoincrement()) // Identifiant unique du modèle
  name        String // Nom du modèle (ex : Modèle Développeur)
  description String // Description courte du modèle
  content     String // Contenu ou structure type du modèle
  offers      JobOffer[] // Toutes les offres liées à ce modèle

  recruteur   Recruteur @relation(fields: [recruteurId], references: [id])
  recruteurId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Application {
  id         String       @id @default(cuid())
  candidat   Candidat     @relation(fields: [candidatId], references: [id])
  candidatId String
  jobOffer   JobOffer     @relation(fields: [jobOfferId], references: [id])
  jobOfferId Int
  column     KanbanColumn @relation(fields: [columnId], references: [id])
  columnId   String // Référence vers la colonne actuelle dans le kanban
  rating     Int? // Note par étoiles (1 à 3)
  message    String? // Message facultatif du candidat
  cv         String? // Lien vers le CV utilisé pour la candidature

  //Migration en attente
  duedate DateTime? // Date d'échéance de la candidature

  notes          ApplicationNote[]
  checklist      ChecklistItem[]
  files          ApplicationFile[]
  collaborateurs ApplicationCollaborateur[] // Relation many-to-many avec les collaborateurs
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model ApplicationNote {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  content       String // Contenu de la note
  authorId      String // ID de l'auteur (Recruteur ou Collaborateur)
  authorName    String? // Nom de l'auteur (nullable temporairement)
  authorType    String // Type d'auteur ("RECRUTEUR" ou "COLLABORATEUR")
  // isPrivate     Boolean   @default(false) // Si la note est privée (visible uniquement par l'auteur)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ChecklistItem {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  title         String // Titre de l'élément de la checklist
  description   String? // Description optionnelle
  isCompleted   Boolean     @default(false)
  createdById   String // ID de l'auteur (Recruteur ou Collaborateur)
  createdByType String // Type d'auteur ("RECRUTEUR" ou "COLLABORATEUR")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ApplicationFile {
  id             String      @id @default(cuid())
  application    Application @relation(fields: [applicationId], references: [id])
  applicationId  String
  fileName       String // Nom original du fichier
  fileUrl        String // URL du fichier stocké
  fileType       String // Type MIME du fichier
  fileSize       Int // Taille du fichier en bytes
  uploadedById   String // ID de l'auteur (Recruteur ou Collaborateur)
  uploadedByType String // Type d'auteur ("RECRUTEUR" ou "COLLABORATEUR")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model KanbanColumn {
  id           String        @id @default(cuid()) // Identifiant unique de la colonne
  color        String
  name         String // Nom de la colonne (ex : "Nouvelles", "Acceptées", etc.)
  order        Int // L'ordre de la colonne dans le Kanban (ex: 1 pour "Nouvelles", 2 pour "En cours", etc.)
  isDefault    Boolean       @default(false) // Si la colonne est une colonne par défaut (non supprimable)
  jobOffer     JobOffer      @relation(fields: [jobOfferId], references: [id])
  jobOfferId   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

// sec
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

///////////ENUM

enum UserType {
  CANDIDAT
  RECRUTEUR
  COLLABORATEUR
}

enum RecruteurType {
  PARTICULIER
  ENTREPRISE
  ENTITE
}

enum Role {
  ADMIN
  USER
  MANAGER
  VIEWER
}

model Experience {
  id           String    @id @default(cuid())
  poste        String
  entreprise   String
  localisation String
  typeContrat  String
  dateDebut    DateTime
  dateFin      DateTime?
  description  String
  competences  String[]
  candidat     Candidat  @relation(fields: [candidatId], references: [id])
  candidatId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Formation {
  id            String    @id @default(cuid())
  diplome       String
  etablissement String
  domaine       String
  dateDebut     DateTime
  dateFin       DateTime?
  description   String
  candidat      Candidat  @relation(fields: [candidatId], references: [id])
  candidatId    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Competence {
  id         String   @id @default(cuid())
  categorie  String
  nom        String
  niveau     Int
  candidat   Candidat @relation(fields: [candidatId], references: [id])
  candidatId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ObjectifCarriere {
  id          String   @id @default(cuid())
  titre       String
  description String
  categorie   String
  dateLimite  DateTime
  progression Int      @default(0)
  etapes      String[]
  candidat    Candidat @relation(fields: [candidatId], references: [id])
  candidatId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlerteEmploi {
  id                String   @id @default(cuid())
  titre             String
  motsCles          String[]
  localisation      String
  typeContrat       String
  salaireMin        Float?
  salaireMax        Float?
  experience        String
  frequence         String
  active            Boolean  @default(true)
  derniereMiseAJour DateTime @default(now())
  nombreResultats   Int      @default(0)
  candidat          Candidat @relation(fields: [candidatId], references: [id])
  candidatId        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  titre      String
  message    String
  type       String // "alerte", "application", etc.
  lu         Boolean  @default(false)
  candidat   Candidat @relation(fields: [candidatId], references: [id])
  candidatId String
  offreId    Int? // ID de l'offre liée à la notification
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
