# ===========================================
# Configuration YLSIX - Variables d'Environnement
# ===========================================

# ===========================================
# JWT SECRETS (OBLIGATOIRES)
# ===========================================
# Clés secrètes pour signer les tokens JWT
# Générez des secrets forts et uniques
JWT_SECRET=votre-secret-jwt-recruiter-super-securise-ici
JWT_SECRET_CANDIDAT=votre-secret-jwt-candidate-super-securise-ici

# ===========================================
# BASE DE DONNÉES (OBLIGATOIRE)
# ===========================================
# URL de connexion à PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ===========================================
# EMAIL (OBLIGATOIRES)
# ===========================================
# Configuration SMTP pour l'envoi d'emails
EMAIL_USER=votre-email@gmail.com
EMAIL_PASS=votre-mot-de-passe-app-gmail

# ===========================================
# REDIS (OPTIONNEL - pour WebSockets)
# ===========================================
# URL de connexion à Redis
# REDIS_URL=redis://localhost:6379

# ===========================================
# CONFIGURATION EMAIL AVANCÉE (OPTIONNEL)
# ===========================================
# Serveur SMTP (par défaut: smtp.gmail.com)
# EMAIL_HOST=smtp.gmail.com
# Port SMTP (par défaut: 587)
# EMAIL_PORT=587

# ===========================================
# APPLICATION (OPTIONNEL)
# ===========================================
# URL publique de votre application
NEXT_PUBLIC_APP_URL=https://ylsix.com

# Environnement (development/production)
NODE_ENV=production

# ===========================================
# NOTES IMPORTANTES
# ===========================================
# 1. Remplacez toutes les valeurs par vos vraies données
# 2. Ne committez jamais ce fichier dans Git
# 3. Gardez vos secrets en sécurité
# 4. Utilisez des mots de passe forts pour JWT_SECRET
# 5. Pour Gmail, utilisez un "mot de passe d'application" 